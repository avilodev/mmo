# Build output and compiled artifacts
**/bin/
**/obj/
build/
dist/
out/
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.pdb
mmo_server

# Vendored libraries required to build from a fresh clone
!Game/lib/*.a

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.sample
*.local
*.secret
*credentials*
*secrets*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
# Certificate directories: keys and certificates never, pin files always.
#
# A blanket `certs/` ignored the pin files too, so neither
# Launcher/certs/login_pins.txt nor Game/certs/realm_pins.txt has ever been
# committed -- and both the launcher and the game refuse every connection
# without one, by design. A fresh clone therefore built a client that could not
# reach any server, while the README said the pin files ship with the
# repository. They do now.
#
# The negations re-include only .txt and .sh; *.key/*.crt/*.pem above still
# exclude anything secret that lands in the same directory.
**/certs/*
!**/certs/*.txt
!**/certs/*.sh

# Local databases
*.db
*.db-*
*.sqlite
*.sqlite3

# Logs, dumps, and temporary files
*.log
# core/client_log.c rotates to client.log.1, .2, .3, which *.log does not match.
*.log.[0-9]*
Game/logs/
*.dump
*.tmp
*.swp
*.bak
/core
/core.*

# Editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Agent scratch directories. See the note in mmo_server/.gitignore: these were
# held back by a local .git/info/exclude, which no other clone has.

# Parsed copy of a large OBJ, rebuilt by the client (render/city_renderer.c)
*.objcache
*.objcache.tmp
